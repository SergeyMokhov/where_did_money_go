# Rust build artifacts
/wdmg/target/
/wdmg-wasm/target/

# Generated WebAssembly module + JS glue (scripts/build-wasm.sh)
web/src/wasm/

# Generated working-dir artifacts (should never live in the repo)
analysis.json
review_queue.json
insights.json
learned.toml
report.html
# ...but the report TEMPLATE is SOURCE, not a rendered artifact — keep it tracked
# even though it shares the "report.html" name with the generated output above.
!wdmg/src/report/templates/report.html

# Playground: the demo data is committed (generate once, use forever — it's
# seeded/deterministic). Only the per-run analysis artifacts below stay ignored.
# The playground's curated insights ARE source (they power the live demo report),
# so keep them tracked even though they share the ignored "insights.json" name.
!playground/config/insights.json

# Local-only convenience scripts (reference private paths — never commit)
*.local.sh

# Editor / OS cruft
*.swp
.DS_Store

# Personal, never-commit files (e.g. your real config bundle for the browser app)
/private/
